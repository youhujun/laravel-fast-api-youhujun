APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=ds_0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FILESYSTEM_DRIVER='local'


# 开始自定义配置
#app配置
APP_TIMEZONE=Asia/Shanghai
APP_FAKER_LOCALE=zh_CN
ASSET_URL=


#database配置
#mysql
DATABASE_URL=null
DB_SOCKET=''
DB_PREFIX='yh_'
DB_STRICT=false
DB_ENGINE=InnoDB

# ds_0配置（和mysql一致）
DB_URL_DS_0=
DB_HOST_DS_0=${DB_HOST}
DB_PORT_DS_0=${DB_PORT}
DB_DATABASE_DS_0=${DB_DATABASE}
DB_USERNAME_DS_0=${DB_USERNAME}
DB_PASSWORD_DS_0=${DB_PASSWORD}
DB_SOCKET_DS_0=${DB_SOCKET}


#redis
REDIS_CLUSTER=redis
REDIS_PREFIX=yh_
REDIS_URL=
REDIS_DB=0
REDIS_CACHE_DB=1
#redis客户端
REDIS_CLIENT=phpredis
#queue
#这里对应的是database下面的redis 驱动
REDIS_QUEUE_CONNECTION=queue
#默认的redis队列名称
REDIS_QUEUE=queue
#默认的redis任务队列名称
REDIS_QUEUE_JOB=job
#这里对应的是database下面的redis 驱动
REDIS_BROADCAST_CONNECTION=broadcast

# elasticsearch配置
ES_HOST=http://127.0.0.1:9200
ES_USER=elastic
ES_PASSWORD=
ES_SHARD_NUMBER=1
ES_REPLICAS_NUMBER=0
ES_PREFIX=yh_
#最大查询条数
ES_MAX_RESULT_WINDOW=10000

#common配置
CHUNK_SIZE=1000
CHUNK_SIZE_ES_SYNC=1000
CHUNK_SIZE_EXPORT=5000
#否是开启熔断保护
IS_SELF_PROTECTED=false
#是否开启系统配置缓存
IS_CACEH_SYSTEM_CONFIG=false
#是否是开发模式
IS_DEVELOP_MODE=true
#微信公众号是否开发模式
WECHAT_OFFICIAL_DEVELOP_MODE=true
#redis限流配置
JOB_BLOCK_NUMBER=0
JOB_ALLOW_NUMBER=10
JOB_EVERY_NUMBER=5
#默认密码
DEFAULT_PASSWORD=abc321

#youhujun配置
#是否完成发布自定配置文件
YOUHUJUN_IS_CUSTOM=false
#源代码是否发布到项目中
YOUHUJUN_PUBLISH=false
#组件包是否运行
YOUHUJUN_RUNING=false
#是否是开发模式
YOUHUJUN_DEVELOP_MODE = true
#是否是微服务
YOUHUJUN_MS=false
#雪花id机器配置
YOUHUJUN_SNOWFLAKE_MACHINE_I=1
# 分片配置（对接ShardFacade的setConfig）
YOUHUJUN_SHARD_DB_COUNT=1
YOUHUJUN_SHARD_TABLE_COUNT=1
YOUHUJUN_SHARD_DB_PREFIX=ds_
YOUHUJUN_SHARD_DEFAULT_DB=ds_0
#app版本号
APP_VERSION=v1
#手机端websocket通信端口号
WEBSOCKET_PORT=8080


#YouHu配置
#是否完成发布自定配置文件
YOUHU_IS_CUSTOM=false
#源代码是否发布到项目中
YOUHU_PUBLISH=false
#组件包是否运行
YOUHU_RUNING=false
#是否是微服务
YOUHU_MS=false
#数据库连接
DB_CONNECTION_YOUHU=ds_0
#雪花id机器配置
YOUHU_SNOWFLAKE_MACHINE_I=1
# 分片配置（对接ShardFacade的setConfig）
YOUHU_SHARD_DB_COUNT=1
YOUHU_SHARD_TABLE_COUNT=1
YOUHU_SHARD_DB_PREFIX=ds_
YOUHU_SHARD_DEFAULT_DB=ds_0

#YouHuShop配置
#是否完成发布自定配置文件
YOUHUSHOP_IS_CUSTOM=false
#源代码是否发布到项目中
YOUHUSHOP_PUBLISH=false
#组件包是否运行
YOUHUSHOP_RUNING=false
#是否是微服务
YOUHUSHOP_MS=false
#数据库连接
DB_CONNECTION_YOUHUSHOP=ds_0
#雪花id机器配置
YOUHUSHOP_SNOWFLAKE_MACHINE_I=1
# 分片配置（对接ShardFacade的setConfig）
YOUHUSHOP_SHARD_DB_COUNT=1
YOUHUSHOP_SHARD_TABLE_COUNT=1
YOUHUSHOP_SHARD_DB_PREFIX=ds_
YOUHUSHOP_SHARD_DEFAULT_DB=ds_0

#XueHu配置
#是否完成发布自定配置文件
XUEHU_IS_CUSTOM=fasle
#源代码是否发布到项目中
XUEHU_PUBLISH=fasle
#组件包是否运行
XUEHU_RUNING=fasle
#是否是微服务
XUEHU_MS=false
#数据库连接
DB_CONNECTION_XUEHU=ds_0
#雪花id机器配置
XUEHU_SNOWFLAKE_MACHINE_I=1
# 分片配置（对接ShardFacade的setConfig）
XUEHU_SHARD_DB_COUNT=1
XUEHU_SHARD_TABLE_COUNT=1
XUEHU_SHARD_DB_PREFIX=ds_
XUEHU_SHARD_DEFAULT_DB=ds_0
#对话模式 default|huoshan|ollama
XUEHU_CHAT_MODE=ollama
#房间业务ID
XUEHU_ROOM_BUSINESSS_ID=
#雪儿业务id
XUEHU_XUEER_BUSINESS_ID=
#游鹄君业务id
XUEHU_YOUHUJUN_BUSINESS_ID=
#火山api_key
XUEHU_HUOSHAN_API_KEY=
#火山model
XUEHU_HUOSHAN_MODEL=
