class {{ class }} extends Model
{
    use HasFactory, SoftDeletes, WithTimeStampFields, WithSnowflakeId, WithCustomConnection, WithShardRouting;

	/**
     * 分片路由基础表名（如需分片请实现此方法）
     */
    protected function getBaseTable(): string
    {
        return '{{table}}';
    }

    /**
     * 分片业务键（如需分片请实现此方法）
